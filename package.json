{
  "name": "angular-lazy-load-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build lazy-load --configuration production",
    "build:demo": "ng build demo --configuration production",
    "watch": "ng build --watch --configuration development",
    "serve:ssr:demo": "node dist/demo/server/server.mjs",
    "build:lib:npm": "ng build lazy-load --configuration production && cd dist/lazy-load && npm pack",
    "publish:lib": "ng build lazy-load --configuration production && cd dist/lazy-load && npm publish --access public",
    "test": "ng test lazy-load --watch=false"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/ssr": "^22.2.5",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@types/express": "^5.0.1",
    "@types/node": "^26.6.6",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.2.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
